    "level": "初级",
    "title": "か",
    "formation": "句末 + か",
    "meaning": "把陈述句变成疑问句。",
    "examples": [
      {
        "jp": "これは本ですか。",
        "cn": "这是书吗？"
      },
      {
        "jp": "田中さんは先生ですか。",
        "cn": "田中先生是老师吗？"
      }
    ],
    "note": "日语一般不需要改变语序。",
    "study": {
      "seen": 0,
      "understood": 0,
      "review": 0
    }
  },
