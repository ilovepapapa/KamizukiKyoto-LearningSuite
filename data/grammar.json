[
  {
    "id": "grammar_001",
    "level": "初级",
    "title": "です／ではありません",
    "formation": "N + です / N + ではありません",
    "meaning": "判断“是／不是”。",
    "examples": [
      {
        "jp": "私は学生です。",
        "cn": "我是学生。"
      },
      {
        "jp": "京都は東京ではありません。",
        "cn": "京都不是东京。"
      }
    ],
    "note": "口语中「ではありません」也常说成「じゃありません」。",
    "study": {
      "seen": 0,
      "understood": 0,
      "review": 0
    }
  },
  {
